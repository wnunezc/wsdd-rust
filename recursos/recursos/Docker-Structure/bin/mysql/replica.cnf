[mysqld]
mysqlx=OFF
lower-case-table-names=1
datadir=/var/lib/mysql
socket=/var/run/mysqld/wsdd-replica.sock
pid-file=/var/run/mysqld/wsdd-replica.pid
port=3307
bind-address=127.0.0.1
server-id=201002
local-infile=ON
sql-mode=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,ALLOW_INVALID_DATES
information-schema-stats-expiry=0
log-bin=binlog
relay-log=relay-bin
log-replica-updates=ON
relay-log-recovery=ON
gtid-mode=ON
enforce-gtid-consistency=ON
skip-replica-start=ON
read-only=ON
super-read-only=ON
