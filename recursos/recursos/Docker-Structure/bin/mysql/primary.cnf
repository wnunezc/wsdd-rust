[mysqld]
mysqlx=OFF
lower-case-table-names=1
datadir=/opt/wsdd-mysql-primary
socket=/var/run/mysqld/wsdd-primary.sock
pid-file=/var/run/mysqld/wsdd-primary.pid
port=3306
bind-address=0.0.0.0
server-id=201001
local-infile=ON
sql-mode=STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,ALLOW_INVALID_DATES
innodb-buffer-pool-size=1G
innodb-log-buffer-size=256M
innodb-flush-log-at-trx-commit=1
information-schema-stats-expiry=0
log-bin=binlog
relay-log=relay-bin
relay-log-recovery=ON
gtid-mode=ON
enforce-gtid-consistency=ON
skip-replica-start=ON
read-only=ON
super-read-only=ON
